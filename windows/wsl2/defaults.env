# Bounded defaults for Windows → WSL2 → Linux Citizen adapter.
# State MUST remain on the Linux filesystem (never /mnt/c by default).

CITIZEN_WSL_DISTRO="${CITIZEN_WSL_DISTRO:-CONRRAD-Citizen}"
CITIZEN_WSL_BASE_DISTRO="${CITIZEN_WSL_BASE_DISTRO:-Ubuntu-24.04}"
CITIZEN_HOME="${CITIZEN_HOME:-/home/citizen/.local/share/conrrad-citizen}"
CITIZEN_UI_HOST="${CITIZEN_UI_HOST:-127.0.0.1}"
CITIZEN_UI_PORT="${CITIZEN_UI_PORT:-3434}"
CITIZEN_UNIT_NAME="${CITIZEN_UNIT_NAME:-citizen-seed-living.service}"
